# Copiar a .env y ajustar los valores segun el entorno/LAN.
# Ningun valor de este archivo debe contener secretos reales.

#Configutacion del usuario del contenedor
DOCKER_USER=gasstation_user
DOCKER_GROUP=gasstation_group

#Frontend
FRONTEND_PORT=4200
FRONTEND_PROD_PORT=80
# Protocolo/host del API. Vacio => la app lo deduce de window.location (sirve en cualquier LAN).
API_PROTOCOL=
API_HOST=

#Backend
SERVER_PORT=8080
# Origenes CORS permitidos (patrones separados por coma). http://*:* sirve en cualquier LAN;
# se puede restringir, p. ej. http://192.168.1.10:9080
APP_CORS_ALLOWED_ORIGINS=http://*:*
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true
SWAGGER_PATH=/swagger-ui.html
API_DOCS_PATH=/v3/api-docs

#Seguridad (JWT + administrador inicial). Cambiar JWT_SECRET y ADMIN_PASSWORD en produccion.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

#Base de datos
POSTGRES_DB_NAME=gasstation_db
POSTGRES_DB_USER=postgres_user
POSTGRES_DB_PASSWORD=change_me
POSTGRES_LOCAL_PORT=5432
